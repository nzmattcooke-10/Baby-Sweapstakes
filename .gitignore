# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# production
# `build/` holds generated output, but sites-vite-plugin.ts is source that
# vite.config.ts imports at build time, so it must be committed for CI to build.
/build/*
!/build/sites-vite-plugin.ts
/dist/
/.wrangler/
/outputs/
/work/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local PGlite development database
/.pglite/
/.pglite-*/

# Firebase local state and service-account credentials
/.firebase/
/firebase-debug.log
/firestore-debug.log
/*service-account*.json
/*serviceAccount*.json

# local editor and AI-tool state
/.claude/
/.codex/
/.cursor/
/.impeccable/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
