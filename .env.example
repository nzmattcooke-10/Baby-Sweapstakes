# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.

# Leave DATABASE_URL unset for local development and the app runs against an
# embedded Postgres (PGlite) in .pglite/ — no account, no Docker, no install.
# Set it to switch to Neon, which is what production uses.

# Neon Postgres connection string.
# Get it from https://console.neon.tech → your project → Connection Details →
# copy the "Connection string" (the pooled one, host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate a fresh one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-me-with-32-random-bytes"
