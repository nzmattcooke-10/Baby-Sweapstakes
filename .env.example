# Firebase App Hosting supplies Google credentials automatically in production.
# No production secrets need to be committed or pasted into this project.

# For the local Firestore emulator only:
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_PROJECT_ID="demo-lewbner"

# Optional. In production the app creates and stores a random session-signing
# secret inside the server-only Firestore area. Set this only if you want to
# override that behaviour in a local environment.
# SESSION_SECRET="replace-me-with-32-random-bytes"
